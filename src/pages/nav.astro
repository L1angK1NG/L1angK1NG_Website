---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNavCategories } from '../lib/site-content';

const categories = getNavCategories();
const total = categories.reduce((sum, c) => sum + c.links.length, 0);
---

<BaseLayout
  title="网址导航"
  description="常用网站与工具的分类导航，按需快速访问。"
  pageClass="content-page"
>
  <header class="page-header">
    <p class="eyebrow">Navigation</p>
    <h1>网址导航</h1>
    <p>常用网站与工具的分类汇总，共 {total} 个站点。</p>
  </header>

  {categories.length === 0 ? (
    <p class="empty-hint">还没有导航内容。在后台「网址导航」里添加后，到「构建发布」上线。</p>
  ) : (
    <>
      <div class="nav-filter">
        <span class="nav-filter__icon" aria-hidden="true">
          <Icon name="search" size={16} />
        </span>
        <input
          type="search"
          id="nav-filter-input"
          placeholder="筛选站点名称 / 简介…"
          aria-label="筛选站点"
          autocomplete="off"
        />
      </div>

      {categories.map((cat) => (
        <section class="proj-section navcat" data-nav-cat aria-labelledby={`cat-${cat.id}`}>
          <div class="proj-section__head">
            <h2 class="proj-section__label" id={`cat-${cat.id}`}>{cat.name}</h2>
            <p class="proj-section__desc">{cat.links.length} 个站点</p>
          </div>
          <div class="proj-grid">
            {cat.links.map((link) => (
              <a
                class="navlink"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                data-nav-link
                data-keywords={`${link.name} ${link.desc} ${cat.name}`.toLowerCase()}
              >
                <span class="navlink__icon" aria-hidden="true">
                  {link.icon ? (
                    <img src={link.icon} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  ) : (
                    <Icon name="globe" size={18} />
                  )}
                </span>
                <span class="navlink__body">
                  <strong class="navlink__name">
                    {link.name}
                    <Icon name="arrow-up-right" size={14} class="navlink__go" />
                  </strong>
                  {link.desc && <small class="navlink__desc">{link.desc}</small>}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
      <p class="empty-hint" id="nav-empty" hidden>没有匹配的站点。</p>
    </>
  )}
</BaseLayout>

<script>
  // 客户端快速筛选：输入即时过滤站点卡片，空分类自动隐藏。
  const initNavFilter = () => {
    const input = document.getElementById('nav-filter-input') as HTMLInputElement | null;
    if (!input || input.dataset.ready === '1') return;
    input.dataset.ready = '1';
    const links = [...document.querySelectorAll<HTMLElement>('[data-nav-link]')];
    const cats = [...document.querySelectorAll<HTMLElement>('[data-nav-cat]')];
    const empty = document.getElementById('nav-empty');

    const apply = () => {
      const kw = input.value.trim().toLowerCase();
      let shown = 0;
      links.forEach((link) => {
        const hit = !kw || (link.dataset.keywords ?? '').includes(kw);
        link.hidden = !hit;
        if (hit) shown += 1;
      });
      cats.forEach((cat) => {
        cat.hidden = !cat.querySelector('[data-nav-link]:not([hidden])');
      });
      if (empty) empty.hidden = shown > 0;
    };
    input.addEventListener('input', apply);
  };

  initNavFilter();
  document.addEventListener('astro:page-load', initNavFilter);
</script>

<style>
  .empty-hint {
    color: var(--text-muted);
    padding: 2rem 0;
  }
  .nav-filter {
    position: relative;
    max-width: 26rem;
    margin-bottom: 1.8rem;
  }
  .nav-filter__icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--text-faint);
    display: inline-flex;
    pointer-events: none;
  }
  .nav-filter input {
    width: 100%;
    padding: 0.65rem 1rem 0.65rem 2.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
  }
  .nav-filter input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--border-strong);
  }

  .navlink {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 0.9rem;
    margin-inline: -0.9rem;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease-out);
  }
  .navlink:hover {
    background: var(--bg-tint);
  }
  .navlink__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-muted);
    overflow: hidden;
    flex-shrink: 0;
  }
  .navlink__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .navlink__body {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }
  .navlink__name {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.98rem;
    font-weight: 620;
  }
  .navlink__go {
    opacity: 0;
    translate: -3px 3px;
    transition: opacity var(--t-fast) var(--ease-out), translate var(--t-fast) var(--ease-out);
  }
  .navlink:hover .navlink__go {
    opacity: 0.75;
    translate: 0 0;
  }
  .navlink__desc {
    color: var(--text-muted);
    font-size: 0.84rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
