---
// 平滑跟随光标（Smooth Cursor）：进入页面后隐藏系统光标，改用网页内的自定义指针。
//   - 指针素材为 shubiao.png（Q 版小公主 + 左上角金色四角星）
//   - 热点精确对齐素材中星星的中心（星心 = 鼠标尖点），指哪打哪
//   - 惯性平滑追随鼠标（光滑移动），移动时朝方向轻微倾斜
//   - 悬停链接/按钮时放大、按下时收缩反馈
// 仅在支持鼠标的设备启用；文本输入框保留系统文本光标；
// prefers-reduced-motion 时直接贴合、无倾斜。元素带 transition:persist，
// View Transitions 换页时保持同一 DOM 节点。
---

<div id="smooth-cursor" aria-hidden="true" transition:persist="smooth-cursor">
  <div id="sc-pos">
    <div class="sc-face">
      <img src="/cursor/shubiao.png" alt="" draggable="false" />
    </div>
  </div>
</div>

<style>
  /* 脚本就绪后才隐藏系统光标（JS 加类），脚本不可用时浏览器保持默认光标。
     用「全部元素 + !important」而不是逐类列举：全局样式里的 cursor 声明
     （如导航图标按钮的 pointer、文章图片的 zoom-in）特异性更高，逐类列举
     会被压过，导致悬停部分按钮时系统光标重新露出来。 */
  :global(html.sc-on),
  :global(html.sc-on *) {
    cursor: none !important;
  }
  /* 文本输入场景必须保留系统文本光标，否则无法看到插入点位置 */
  :global(html.sc-on input:is(:not([type='button']):not([type='submit']):not([type='checkbox']):not([type='radio']))),
  :global(html.sc-on textarea),
  :global(html.sc-on [contenteditable]) {
    cursor: text !important;
  }

  #smooth-cursor {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2147483000;
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }
  #smooth-cursor.sc-visible {
    opacity: 1;
  }

  /* 外层每帧只写 transform（translate3d/rotate），缩放类动画放内层，互不覆盖 */
  #sc-pos {
    position: fixed;
    left: 0;
    top: 0;
    will-change: transform;
  }

  .sc-face {
    /* 热点偏移：素材中星星中心位于 (14%, 20%)，
       显示宽 100px 时即向左上偏移约 (14px, 19px)，让星心钉在鼠标位置 */
    margin: -19px 0 0 -14px;
    transition: transform 0.22s ease-out;
    transform: scale(1);
  }

  .sc-face img {
    display: block;
    width: 100px;
    height: auto;
    user-select: none;
    /* 素材自带描边，浅阴影增加与页面内容的层次 */
    filter: drop-shadow(0 3px 8px rgba(40, 60, 120, 0.22));
  }

  /* 悬停可交互元素：轻微放大 */
  :global(#smooth-cursor.sc-hover) .sc-face {
    transform: scale(1.08);
  }
  /* 按下反馈：收缩 */
  :global(#smooth-cursor.sc-press) .sc-face {
    transform: scale(0.9);
    transition-duration: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-face {
      transition: none;
    }
    :global(#smooth-cursor.sc-hover) .sc-face {
      transform: scale(1.04);
    }
    :global(#smooth-cursor.sc-press) .sc-face {
      transform: scale(0.96);
    }
  }
</style>

<script>
  // 单个 rAF 循环驱动全部状态；transition:persist 保证换页后元素仍在，
  // 事件全部委托到 window/document，无需在 astro:page-load 时重绑。
  const finePointer = window.matchMedia('(pointer: fine)');

  function initSmoothCursor() {
    const root = document.getElementById('smooth-cursor');
    if (!root || finePointer.matches === false) return;
    // ClientRouter 换页会重置 <html> 的 class，每次 init 都重新盖上（幂等）
    document.documentElement.classList.add('sc-on');
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    // 目标位置 = 真实指针；光标用惯性追随目标，形成光滑移动
    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let curX = targetX;
    let curY = targetY;
    let tilt = 0;
    let lastTime = performance.now();

    // 悬停判定走事件委托；input/textarea 除外（那里保留系统文本光标）
    const HOVERABLE = 'a, button, label, summary, select, [role="button"], [role="link"]';

    window.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
      const rootNow = document.getElementById('smooth-cursor');
      if (rootNow) {
        rootNow.classList.add('sc-visible');
        const t = e.target;
        rootNow.classList.toggle(
          'sc-hover',
          t instanceof Element && t.closest(HOVERABLE) !== null,
        );
      }
    }, { passive: true });

    window.addEventListener('mousedown', () => {
      document.getElementById('smooth-cursor')?.classList.add('sc-press');
    });
    window.addEventListener('mouseup', () => {
      document.getElementById('smooth-cursor')?.classList.remove('sc-press');
    });
    document.documentElement.addEventListener('mouseenter', () => {
      document.getElementById('smooth-cursor')?.classList.add('sc-visible');
    });
    document.documentElement.addEventListener('mouseleave', () => {
      document.getElementById('smooth-cursor')?.classList.remove('sc-visible');
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    function tick(now) {
      const dt = Math.min(64, now - lastTime) || 16;
      lastTime = now;

      // 每帧重新取元素：换页/HMR 重建 DOM 时自愈，避免循环驱动游离节点
      const pos = document.getElementById('sc-pos');
      if (pos) {
        if (reduced.matches) {
          // 降级：直接贴合指针，无惯性、无倾斜
          curX = targetX;
          curY = targetY;
          tilt = 0;
        } else {
          // 惯性追随：指数平滑、帧率无关；k 小收敛快，兼顾手感与指向精度
          const k = 1 - Math.pow(0.0008, dt / 1000);
          const nextX = curX + (targetX - curX) * k;
          const nextY = curY + (targetY - curY) * k;
          const vx = nextX - curX;
          curX = nextX;
          curY = nextY;

          // 移动感：横向速度转化为轻微倾斜角，指数回正
          const targetTilt = Math.max(-6, Math.min(6, vx * 0.5));
          tilt += (targetTilt - tilt) * Math.min(1, dt / 110);
        }

        pos.style.transform = `translate3d(${curX}px, ${curY}px, 0) rotate(${tilt.toFixed(2)}deg)`;
      }

      requestAnimationFrame(tick);
    }

    // 防止换页脚本重跑时叠加多个循环
    if (!window.__scLoop) {
      window.__scLoop = true;
      requestAnimationFrame(tick);
    }
  }

  initSmoothCursor();
  document.addEventListener('astro:page-load', initSmoothCursor);
</script>
