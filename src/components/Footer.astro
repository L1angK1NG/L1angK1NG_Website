---
import Icon from './Icon.astro';
import { site } from '../lib/posts';
import { getFooter } from '../lib/site-content';

const footer = getFooter();
const year = new Date().getFullYear();

// 版权文字支持 {year} / {author} 占位符，避免后台把年份写死。
const copyright = footer.copyright
  .replaceAll('{year}', String(year))
  .replaceAll('{author}', site.author);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__id">
      <img
        src="/avatars/avatar.jpg"
        alt={site.author}
        class="site-footer__avatar"
        width="40"
        height="40"
      />
      <div class="site-footer__id-text">
        <strong>{site.author}</strong>
        <span>{footer.tagline}</span>
      </div>
    </div>

    <nav class="site-footer__links" aria-label="页脚链接">
      {footer.links.map((item, index) => {
        // 分隔线沿用「外部链接 | 社群」的分组语义：插在第一条无链接（纯文字）项前
        const showSep = !item.href && index > 0 && footer.links.slice(0, index).some((l) => l.href);
        return (
          <>
            {showSep && <span class="site-footer__sep" aria-hidden="true" />}
            {item.href ? (
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {item.icon && <Icon name={item.icon} size={15} />}
                {item.label}
              </a>
            ) : (
              <span class="site-footer__item">
                {item.icon && <Icon name={item.icon} size={15} />}
                {item.label}
              </span>
            )}
          </>
        );
      })}
    </nav>
  </div>

  <div class="site-footer__bar">
    <span>{copyright}</span>
    <span aria-hidden="true">·</span>
    <a href={site.url}>{site.url.replace('https://', '')}</a>
    <span aria-hidden="true">·</span>
    {/* 归属文字在后台保存时已做白名单净化，此处按含链接的富文本渲染 */}
    <span set:html={footer.attribution} />
  </div>
</footer>
