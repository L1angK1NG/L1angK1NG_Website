---
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import SmoothCursor from '../components/SmoothCursor.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Nav from '../components/Nav.astro';
import { ClientRouter } from 'astro:transitions';
import { absoluteUrl, site } from '../lib/posts';
import '../styles/global.css';
// 仅主题初始化与 API 哨兵两段极小脚本内联在 <head>（必须在首帧前同步执行 /
// 早于一切请求）；其余站点脚本统一打包在 src/scripts/site/，可被浏览器缓存。
import apiGuardSrc from '../scripts/inline/api-guard.js?raw';
import themeInitSrc from '../scripts/inline/theme-init.js?raw';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: unknown;
}

const {
  title = site.name,
  description = site.description,
  pageClass = '',
  image = '/avatars/avatar.jpg',
  type = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} - ${site.name}`;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const imageUrl = image ? absoluteUrl(image) : undefined;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: site.author, url: site.url },
};

const ldScripts = [websiteSchema, ...(jsonLd ? [jsonLd] : [])];

// 路由过渡动画刻意只作用于页面内容。站点外壳保持静止，离场内容几乎
// 完全消失后新内容才开始进场，文字永远不会叠在文字上交叉淡变。
const routeMotion = {
  forwards: {
    old: {
      name: 'blogRouteOut',
      duration: '70ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'blogRouteIn',
      duration: '130ms',
      delay: '70ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'blogRouteOut',
      duration: '70ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'blogRouteIn',
      duration: '130ms',
      delay: '70ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang="zh-CN" transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta id="theme-color" name="theme-color" content="#f8f7f4" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/jpeg" href="/avatars/avatar.jpg" />
    <link rel="apple-touch-icon" href="/avatars/avatar.jpg" />
    {import.meta.env.PUBLIC_TWIKOO_ENV_ID && (
      <link rel="preconnect" href={import.meta.env.PUBLIC_TWIKOO_ENV_ID} crossorigin />
    )}
    <link rel="preconnect" href="https://cravatar.cn" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={absoluteUrl('/rss.xml')}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {ldScripts.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    ))}
    <ClientRouter />
    <script is:inline set:html={apiGuardSrc}></script>
    <script is:inline set:html={themeInitSrc}></script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    {pageClass === 'article-page' && (
      <div class="reading-progress" aria-hidden="true">
        <span data-reading-progress></span>
      </div>
    )}
    <Nav />
    <AnnouncementBar />
    <main id="main" transition:name="page-content" transition:animate={routeMotion}>
      <slot />
    </main>
    <Footer />
    <MusicPlayer />
    <SmoothCursor />
    <button type="button" class="to-top" data-to-top aria-label="回到顶部">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6" />
      </svg>
    </button>
    {/* 站点脚本装配（显现动画/主题切换/灯箱/打点等）：打包为可缓存模块，
        换页时由 astro:after-swap 重新绑定页面元素级监听。 */}
    <script>
      import '../scripts/site/index.js';
    </script>
  </body>
</html>
