SITE_URL=https://example.com

# —— 后台管理端 ——
# 管理员登录名
ADMIN_USER=admin
# 密码哈希（scrypt）。用 `npm run admin:hash` 生成，不要写明文密码。
ADMIN_PASSWORD_HASH=replace-me-with-npm-run-admin-hash
# 会话签名密钥（随机长字符串）
SESSION_SECRET=replace-me-with-a-long-random-string
# 管理端监听端口（nginx 反代到这个端口）
ADMIN_PORT=4000
# 部署在 HTTPS 后面时设为 true；本地开发保持 false
COOKIE_SECURE=false

# —— 前台功能 ——
# 留空则使用博客内置评论后端（后台「评论」模块管理）；接入官方 Twikoo 时填写其 API 地址
PUBLIC_TWIKOO_ENV_ID=
# 网易云音乐歌单 ID（示例占位，替换为你自己的歌单 ID）
PUBLIC_NETEASE_PLAYLIST_ID=你的网易云歌单ID
# Meting API 地址（公共音乐解析服务）
PUBLIC_MUSIC_API=https://meting.mikus.ink/api

# —— 数据备份（每次「构建发布」成功后自动执行）——
# 备份开关：false 时发布后不做任何备份。备份在系统临时目录完成、推送后即清理，
# 本地不留缓存副本。
BACKUP_ENABLED=true
# 远端私人仓库地址（GitHub 私库）。留空则跳过备份（不产生任何本地缓存）。
# 首次启用：先在 GitHub 上创建一个私有空仓库（名称与该地址一致），之后无需其他操作。
# 注意：下面仅为格式示例，请替换为你自己的仓库地址；真实地址只写在 .env，勿提交到仓库。
BACKUP_REMOTE_URL=https://github.com/your-name/your-blog-backup.git
# 是否把 .env（后台凭据与密钥）一并备份；私库务必保持私有
BACKUP_INCLUDE_ENV=true
